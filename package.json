{
  "name": "dsh-boot-sequence",
  "version": "0.1.0",
  "description": "DSH 启动界面：黑底白字数据流 + 终端安全启动序列（可跳过、可重播）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "boot",
    "splash",
    "matrix",
    "terminal"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "license": "MIT"
}
